{
  "annotations": [],
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "dataId": "prometheus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "User service request rate broken down by route and status code.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "requests/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "req/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "alertThreshold": true,
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "expr": "sum(rate(kit_user_http_requests_total[5m])) by (route, status)",
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "dataId": "prometheus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentage of user service requests that are unhealthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "unhealthy %",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "alertThreshold": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "expr": "100 * sum(rate(kit_user_http_requests_total{status=~\"5..|429\"}[5m])) by (route) / sum(rate(kit_user_http_requests_total[5m])) by (route)",
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Unhealthy request ratio",
      "type": "timeseries"
    },
    {
      "dataId": "prometheus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Panic rate in the user service.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "panics/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "alertThreshold": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "expr": "sum(rate(kit_user_panics_total[5m]))",
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Recovered panic rate",
      "type": "timeseries"
    },
    {
      "dataId": "loki",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Detailed error logs from the user service. Stack traces and request context are only available here.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "options": {
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.5.0",
      "targets": [
        {
          "expr": "{service=\"user\"} | unpack_json | level != \"info\"",
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "User service error logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["kit-design", "user-service", "observability"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Kit Design User Service Overview",
  "uid": "kit-design-user-service-overview",
  "version": 1,
  "weekStart": ""
}
